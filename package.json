{
  "name": "my-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An open-world forest you can walk around in, drawn to look real with three.js.",
  "scripts": {
    "dev": "vite",
    "api": "mkdir -p dist && wrangler dev --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "npm run build && node test/smoke.mjs",
    "together": "node test/together.mjs",
    "hike": "node tools/hike.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.165.0"
  }
}
