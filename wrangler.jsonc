{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-world",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",

  // The built site is served straight from Cloudflare's edge; only /api/*
  // reaches the Worker.
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },

  // Replace database_id with the one `npm run db:create` prints. Local
  // development uses its own SQLite file under .wrangler/ and ignores it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-world",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],

  "observability": { "enabled": true }
}
