{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-world",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",

  // The built site is served straight from Cloudflare's edge; only /api/*
  // reaches the Worker.
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },

  // A world lives in its own Durable Object, which holds it in its own SQLite.
  // Nothing else stores a world, so there is no database to create first.
  "durable_objects": {
    "bindings": [{ "name": "WORLD", "class_name": "World" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }],

  "observability": { "enabled": true }
}
